{
  "manifest_version": 3,
  "name": "Swipe to Close - gesture probe",
  "version": "0.1.0",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["http://127.0.0.1/*", "http://localhost/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}
