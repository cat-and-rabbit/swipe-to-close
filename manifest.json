{
  "manifest_version": 3,
  "name": "Swipe to Close (for macOS)",
  "version": "1.1.0",
  "minimum_chrome_version": "106",
  "description": "Macトラックパッドの2本指スワイプで、戻る履歴がない時にタブを自動で閉じます",
  "permissions": ["tabs", "storage", "webNavigation"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["gesture.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
